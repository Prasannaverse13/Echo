# syntax=docker/dockerfile:1.7
# ---------------------------------------------------------------------------
# Echo Worker — Cloud Run service that subscribes to the `echo-runs` Pub/Sub
# topic and invokes the Echo ADK agent for each input.
# ---------------------------------------------------------------------------

ARG workerDir=.
#
# Build:   docker build -f Dockerfile.worker -t echo-worker .
# Deploy:  gcloud run deploy echo-worker --image ... --region us-central1
# ---------------------------------------------------------------------------

# ---------- 1. Dependencies ----------
FROM node:22-bookworm-slim AS deps
WORKDIR /app
RUN corepack enable
# Pin pnpm 9 — same rationale as the main Dockerfile. --force
# overwrites the corepack shim at /usr/local/bin/pnpm.
RUN npm install -g pnpm@9 --force
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile

# ---------- 2. Build (esbuild bundles TS → single CJS file) ----------
FROM node:22-bookworm-slim AS builder
WORKDIR /app
RUN corepack enable
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN ./node_modules/.bin/esbuild src/worker/index.ts \
  --bundle --platform=node --target=node20 --format=cjs \
  --outfile=dist/worker/index.js \
  --alias:@=./src \
  --external:@google-cloud/* \
  --external:@google/genai \
  --external:firebase-admin \
  --minify

# ---------- 3. Production runner (distroless, ~150MB) ----------
FROM gcr.io/distroless/nodejs20-debian12 AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1

# Copy the bundled worker + node_modules for the @google-cloud/* externals
COPY --from=builder /app/dist/worker ./dist/worker
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

# Non-root user (distroless runs as nonroot by default)
USER nonroot

EXPOSE 8080
CMD ["dist/worker/index.js"]
