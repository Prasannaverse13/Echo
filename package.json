{
  "name": "echo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-test.cjs",
    "smoke:fallback": "node scripts/smoke-fallback.cjs",
    "smoke:auth": "node scripts/test-auth.cjs",
    "smoke:agent": "tsx scripts/smoke-agent.ts",
    "smoke:worker": "node scripts/smoke-worker.cjs",
    "worker": "tsx watch src/worker/index.ts",
    "worker:once": "tsx src/worker/index.ts",
    "worker:bind": "powershell -ExecutionPolicy Bypass -File scripts/bind-subscription.ps1",
    "worker:deploy": "gcloud run deploy echo-worker --source . --region us-central1",
    "vercel:set-google-client": "python vercel_set_client.py"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.0.0",
    "@google-cloud/pubsub": "^6.0.1",
    "@google-cloud/vertexai": "^1.12.0",
    "@google/genai": "^2.18.0",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "esbuild",
      "protobufjs",
      "unrs-resolver"
    ]
  }
}
